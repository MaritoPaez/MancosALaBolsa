<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema principal de la app (Oscuro por defecto) -->
    <style name="Theme.MancosALaBolsaV1" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
    </style>

    <!-- Tema para evitar el "flash blanco" inicial -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.MancosALaBolsaV1</item>
    </style>
</resources>